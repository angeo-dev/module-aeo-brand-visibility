<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">angeo_brand_vis_history_listing.angeo_brand_vis_history_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>angeo_brand_vis_history_columns</spinner>
        <deps>
            <dep>angeo_brand_vis_history_listing.angeo_brand_vis_history_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="angeo_brand_vis_history_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Angeo_AeoBrandVisibility::view</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="angeo_brand_vis_history_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="angeo_brand_vis_history_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">angeo_brand_vis_history_listing.angeo_brand_vis_history_listing.angeo_brand_vis_history_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">view</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <column name="id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Run At</label>
            </settings>
        </column>
        <column name="brand_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Brand</label>
            </settings>
        </column>
        <column name="store_id" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Store View</label>
            </settings>
        </column>
        <column name="overall_score" class="Angeo\AeoBrandVisibility\Ui\Component\Listing\Column\Score" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Score</label>
            </settings>
        </column>
        <column name="grade" class="Angeo\AeoBrandVisibility\Ui\Component\Listing\Column\Grade" sortOrder="60">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Grade</label>
            </settings>
        </column>
        <column name="samples" sortOrder="70">
            <settings>
                <label translate="true">Samples</label>
            </settings>
        </column>
        <column name="share_of_voice" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Share of Voice %</label>
            </settings>
        </column>
        <column name="win_rate" sortOrder="90">
            <settings>
                <label translate="true">Win Rate %</label>
            </settings>
        </column>
        <column name="signal_rates" class="Angeo\AeoBrandVisibility\Ui\Component\Listing\Column\SignalRates" sortOrder="100">
            <settings>
                <label translate="true">Signals</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="accuracy_issues" sortOrder="110">
            <settings>
                <label translate="true">Accuracy Issues</label>
            </settings>
        </column>
        <column name="triggered_by" sortOrder="120">
            <settings>
                <filter>text</filter>
                <label translate="true">Triggered By</label>
            </settings>
        </column>
        <column name="status" sortOrder="130">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Angeo\AeoBrandVisibility\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <settings>
                <indexField>id</indexField>
                <label translate="true">Action</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
