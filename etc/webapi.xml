<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/angeo/brand-visibility/latest" method="GET">
        <service class="Angeo\AeoBrandVisibility\Api\ReportManagementInterface" method="getLatest"/>
        <resources>
            <resource ref="Angeo_AeoBrandVisibility::run"/>
        </resources>
    </route>
    <route url="/V1/angeo/brand-visibility/latest/store/:storeId" method="GET">
        <service class="Angeo\AeoBrandVisibility\Api\ReportManagementInterface" method="getLatest"/>
        <resources>
            <resource ref="Angeo_AeoBrandVisibility::run"/>
        </resources>
    </route>
</routes>
