<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="angeo_aeo" translate="label" sortOrder="200">
            <label>Angeo AEO</label>
        </tab>

        <section id="angeo_brand_vis" translate="label" type="text" sortOrder="50"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Brand Visibility (AI Models)</label>
            <tab>angeo_aeo</tab>
            <resource>Angeo_AeoBrandVisibility::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Brand Visibility</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, brand visibility is included in every AEO audit run for this scope.</comment>
                </field>
                <field id="run_mode" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Run Mode</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\RunMode</source_model>
                    <comment>Background queue needs the angeoBrandVisAuditRun consumer to be running. Use inline only on installations without message queue consumers.</comment>
                </field>
                <field id="brand_name" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand Name</label>
                    <comment>The exact name an AI should recognise. Leave empty to use the store name.</comment>
                </field>
                <field id="brand_domain" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand Domain</label>
                    <comment>For example mystore.nl. Used to detect URL citations. Leave empty to use the store base URL.</comment>
                </field>
                <field id="brand_keywords" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand Aliases</label>
                    <comment>Comma separated alternate spellings and sub-brands.</comment>
                </field>
                <field id="store_category" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store Category</label>
                    <comment>What you sell, in two or three words. Leave empty to derive it from the catalogue. A generic value loses every query to the large marketplaces.</comment>
                </field>
                <field id="top_products" translate="label comment" type="textarea" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Top Products</label>
                    <comment>One product per line. Leave empty to derive from the catalogue.</comment>
                </field>
                <field id="cache_ttl_hours" translate="label comment" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Cache Lifetime (hours)</label>
                    <validate>validate-digits validate-digits-range digits-range-0-720</validate>
                    <comment>Set 0 to disable caching entirely.</comment>
                </field>
                <field id="log_enabled" translate="label comment" type="select" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Log Prompts and Answers</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Writes to var/log/angeo_aeo_brand_visibility.log. Keep off in production.</comment>
                </field>
            </group>
            <group id="chatgpt" translate="label comment" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>ChatGPT (OpenAI)</label>
                <comment>Grounding requires a search-capable model such as gpt-4o-search-preview.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. It is never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Model</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\GptModel</source_model>
                    <comment>Model identifiers change often; pick the closest match and adjust after a provider release.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="grounding" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Answer from live web search</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Grounded answers reflect what is on the web today, so the score responds to changes you make. Memory-only answers lag by months and cost less.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max Answer Tokens</label>
                    <validate>validate-digits validate-digits-range digits-range-64-4000</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="temperature" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Temperature</label>
                    <validate>validate-number validate-number-range number-range-0-2</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-digits validate-digits-range digits-range-5-300</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="claude" translate="label comment" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Claude (Anthropic)</label>
                <comment>Grounding uses the server-side web search tool and is billed per search.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. It is never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Model</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\ClaudeModel</source_model>
                    <comment>Model identifiers change often; pick the closest match and adjust after a provider release.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="grounding" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Answer from live web search</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Grounded answers reflect what is on the web today, so the score responds to changes you make. Memory-only answers lag by months and cost less.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max Answer Tokens</label>
                    <validate>validate-digits validate-digits-range digits-range-64-4000</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="temperature" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Temperature</label>
                    <validate>validate-number validate-number-range number-range-0-2</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-digits validate-digits-range digits-range-5-300</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="perplexity" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Perplexity</label>
                <comment>Always answers from live web search. The most responsive signal of the five.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. It is never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Model</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\PerplexityModel</source_model>
                    <comment>Model identifiers change often; pick the closest match and adjust after a provider release.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="max_tokens" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max Answer Tokens</label>
                    <validate>validate-digits validate-digits-range digits-range-64-4000</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="temperature" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Temperature</label>
                    <validate>validate-number validate-number-range number-range-0-2</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-digits validate-digits-range digits-range-5-300</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="gemini" translate="label comment" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Gemini (Google)</label>
                <comment>Grounding uses Google Search as a tool.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. It is never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Model</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\GeminiModel</source_model>
                    <comment>Model identifiers change often; pick the closest match and adjust after a provider release.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="grounding" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Answer from live web search</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Grounded answers reflect what is on the web today, so the score responds to changes you make. Memory-only answers lag by months and cost less.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max Answer Tokens</label>
                    <validate>validate-digits validate-digits-range digits-range-64-4000</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="temperature" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Temperature</label>
                    <validate>validate-number validate-number-range number-range-0-2</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-digits validate-digits-range digits-range-5-300</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="groq" translate="label comment" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Groq</label>
                <comment>Free tier, memory-only answers. Useful as a baseline, not as evidence of live visibility.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. It is never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Model</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\GroqModel</source_model>
                    <comment>Model identifiers change often; pick the closest match and adjust after a provider release.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="max_tokens" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max Answer Tokens</label>
                    <validate>validate-digits validate-digits-range digits-range-64-4000</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="temperature" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Temperature</label>
                    <validate>validate-number validate-number-range number-range-0-2</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Timeout (seconds)</label>
                    <validate>validate-digits validate-digits-range digits-range-5-300</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="queries" translate="label" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Queries</label>
                <field id="samples" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Samples per Query</label>
                    <validate>validate-digits validate-digits-range digits-range-1-10</validate>
                    <comment>Each provider and prompt pair is asked this many times. Higher values narrow the confidence interval and raise API cost proportionally.</comment>
                </field>
                <field id="max_prompts" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Maximum Prompts per Provider</label>
                    <validate>validate-digits validate-digits-range digits-range-0-20</validate>
                    <comment>Set 0 to run every enabled prompt.</comment>
                </field>
                <field id="delay_between_ms" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Delay Between Calls (ms)</label>
                    <validate>validate-digits validate-digits-range digits-range-0-10000</validate>
                    <comment>Paces requests to stay inside provider rate limits.</comment>
                </field>
                <field id="max_retries" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Retries per Call</label>
                    <validate>validate-digits validate-digits-range digits-range-0-5</validate>
                </field>
                <field id="system_prompt" translate="label" type="textarea" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>System Prompt</label>
                </field>
                <field id="enable_recommendation" translate="label" type="select" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Best stores in category</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_recommendation" translate="label comment" type="textarea" sortOrder="101" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <comment>Placeholders: {{brand}}, {{domain}}, {{category}}, {{products}}.</comment>
                    <depends><field id="enable_recommendation">1</field></depends>
                </field>
                <field id="enable_category" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Where to buy</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_category" translate="label" type="textarea" sortOrder="111" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <depends><field id="enable_category">1</field></depends>
                </field>
                <field id="enable_brand_direct" translate="label" type="select" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Tell me about this brand</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_brand_direct" translate="label" type="textarea" sortOrder="121" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <depends><field id="enable_brand_direct">1</field></depends>
                </field>
                <field id="enable_product_search" translate="label" type="select" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Product search</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_product_search" translate="label" type="textarea" sortOrder="131" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <depends><field id="enable_product_search">1</field></depends>
                </field>
                <field id="enable_comparison" translate="label" type="select" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Compare with competitors</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_comparison" translate="label" type="textarea" sortOrder="141" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <depends><field id="enable_comparison">1</field></depends>
                </field>
                <field id="enable_gift_guide" translate="label" type="select" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Prompt: Gift guide</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="prompt_gift_guide" translate="label" type="textarea" sortOrder="151" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Override text</label>
                    <depends><field id="enable_gift_guide">1</field></depends>
                </field>
                <field id="custom_prompts" translate="label comment" type="textarea" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Prompts</label>
                    <comment>One per line, in the form key: prompt text.</comment>
                </field>
            </group>

            <group id="competitors" translate="label" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Competitors</label>
                <field id="list" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tracked Competitors</label>
                    <comment>One per line, in the form Name | domain.com. Used for share of voice and win rate.</comment>
                </field>
            </group>

            <group id="analysis" translate="label" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Analysis</label>
                <field id="language" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Analysis Language</label>
                    <source_model>Angeo\AeoBrandVisibility\Model\Config\Source\AnalysisLanguage</source_model>
                    <comment>English phrases are always matched in addition to the selected language.</comment>
                </field>
                <field id="extra_tlds" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Extra Top-Level Domains</label>
                    <comment>Comma separated, for example nl, de, be, co.uk. Needed so the accuracy check recognises country domains.</comment>
                </field>
            </group>

            <group id="scoring" translate="label" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Scoring</label>
                <field id="weight_mentioned" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Weight: Mentioned</label>
                    <validate>validate-number validate-number-range number-range-0-10</validate>
                </field>
                <field id="weight_recommended" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Weight: Recommended</label>
                    <validate>validate-number validate-number-range number-range-0-10</validate>
                </field>
                <field id="weight_url_cited" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Weight: URL Cited</label>
                    <validate>validate-number validate-number-range number-range-0-10</validate>
                </field>
                <field id="weight_first_result" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Weight: First Position</label>
                    <validate>validate-number validate-number-range number-range-0-10</validate>
                </field>
                <field id="weight_positive_sentiment" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Weight: Positive Tone</label>
                    <validate>validate-number validate-number-range number-range-0-10</validate>
                </field>
                <field id="negative_penalty" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Negative Tone Penalty</label>
                    <validate>validate-number validate-number-range number-range-0-1</validate>
                    <comment>Share of the earned score removed when negative wording surrounds the brand. 0.5 halves it.</comment>
                </field>
                <field id="pass_threshold" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Pass Threshold</label>
                    <validate>validate-digits validate-digits-range digits-range-0-100</validate>
                </field>
                <field id="warn_threshold" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Warning Threshold</label>
                    <validate>validate-digits validate-digits-range digits-range-0-100</validate>
                </field>
            </group>

            <group id="alerts" translate="label" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Alerts</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Regression Alerts</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="recipient" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Alert Recipient</label>
                    <validate>validate-email</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="drop_threshold" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Drop Threshold (points)</label>
                    <validate>validate-digits validate-digits-range digits-range-1-100</validate>
                    <comment>An alert is only raised when the drop also exceeds the confidence margin of the run.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="webhook_url" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook URL</label>
                    <comment>HTTPS only. Hosts that resolve to private or reserved addresses are rejected.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="webhook_allow_private" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Allow Private Webhook Targets</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Only enable for an internal endpoint you control. This removes the request forgery protection.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="cron" translate="label" sortOrder="120" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Scheduled Runs</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable Schedule</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="schedule" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Cron Expression</label>
                    <comment>Runs in the dedicated angeo_brand_visibility cron group.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="retention" translate="label" sortOrder="130" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Data Retention</label>
                <field id="max_records_per_store" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Runs Kept per Store View</label>
                    <validate>validate-digits validate-digits-range digits-range-10-1000</validate>
                </field>
                <field id="max_age_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Maximum Age (days)</label>
                    <validate>validate-digits validate-digits-range digits-range-7-3650</validate>
                </field>
            </group>
        </section>
    </system>
</config>
