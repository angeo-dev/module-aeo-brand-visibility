<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Angeo\AeoBrandVisibility\Api\BrandVisibilityServiceInterface"
                type="Angeo\AeoBrandVisibility\Service\BrandVisibilityService"/>
    <preference for="Angeo\AeoBrandVisibility\Api\AuditResultRepositoryInterface"
                type="Angeo\AeoBrandVisibility\Model\AuditResultRepository"/>
    <preference for="Angeo\AeoBrandVisibility\Api\Data\AuditResultInterface"
                type="Angeo\AeoBrandVisibility\Model\AuditResult"/>

    <!-- Dedicated log file -->
    <virtualType name="Angeo\AeoBrandVisibility\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/angeo_aeo_brand_visibility.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Angeo\AeoBrandVisibility\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <!--
        Provider pool. Adding a provider is a di.xml entry, not a code change:
        implement AiProviderInterface and append it here.
    -->
    <type name="Angeo\AeoBrandVisibility\Service\Provider\ProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="chatgpt" xsi:type="object">
                    Angeo\AeoBrandVisibility\Service\Provider\ChatGptProvider
                </item>
                <item name="claude" xsi:type="object">
                    Angeo\AeoBrandVisibility\Service\Provider\ClaudeProvider
                </item>
                <item name="perplexity" xsi:type="object">
                    Angeo\AeoBrandVisibility\Service\Provider\PerplexityProvider
                </item>
                <item name="gemini" xsi:type="object">
                    Angeo\AeoBrandVisibility\Service\Provider\GeminiProvider
                </item>
                <item name="groq" xsi:type="object">
                    Angeo\AeoBrandVisibility\Service\Provider\GroqProvider
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Angeo\AeoBrandVisibility\Service\BrandVisibilityService">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\Service\Provider\AbstractHttpProvider">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\Service\AlertNotifier">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\Service\Webhook\WebhookClient">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\MessageQueue\AuditRunConsumer">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\Cron\RunBrandVisibilityAudit">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Angeo\AeoBrandVisibility\Cron\CleanupAuditResults">
        <arguments>
            <argument name="logger" xsi:type="object">Angeo\AeoBrandVisibility\Logger\Logger</argument>
        </arguments>
    </type>

    <!-- Register as a live_signal checker inside angeo/module-aeo-audit -->
    <type name="Angeo\AeoAudit\Model\AuditRunner">
        <arguments>
            <argument name="checkers" xsi:type="array">
                <item name="brand_visibility" xsi:type="object">
                    Angeo\AeoBrandVisibility\Model\Checker\BrandVisibilityChecker
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Admin grid data source -->
    <virtualType name="Angeo\AeoBrandVisibility\Model\ResourceModel\AuditResult\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">angeo_brand_visibility_audit</argument>
            <argument name="resourceModel" xsi:type="string">
                Angeo\AeoBrandVisibility\Model\ResourceModel\AuditResult
            </argument>
            <argument name="identifierName" xsi:type="string">id</argument>
            <argument name="connectionName" xsi:type="string">default</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="angeo_brand_vis_history_listing_data_source" xsi:type="string">
                    Angeo\AeoBrandVisibility\Model\ResourceModel\AuditResult\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="angeo_brand_visibility_run" xsi:type="object">
                    Angeo\AeoBrandVisibility\Console\Command\RunBrandAuditCommand
                </item>
            </argument>
        </arguments>
    </type>
</config>
